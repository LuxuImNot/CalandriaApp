<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- URL en la que escucha el servicio. En el servidor: http://0.0.0.0:8733 o la IP Tailscale -->
    <add key="BaseUrl" value="http://localhost:8733" />

    <!-- Secreto de firma JWT (HS256). Mínimo 32 bytes. Vive SOLO en el servidor.
         Rótalo en producción y no lo compartas con el cliente. -->
    <add key="JwtSecreto" value="ApjyUpht58mHplcNHxaYlWNibLd+V+hdxS6k8+reZ4ydDKCEby4+L6xXLrArboow" />
    <add key="JwtIssuer" value="Calandria.Api" />
    <add key="JwtAudience" value="CalandriaCliente" />
    <add key="JwtHorasVigencia" value="12" />
  </appSettings>
  <connectionStrings>
    <!-- Esta cadena SOLO existe en el servidor donde corre el API. El cliente
         dejará de tener credenciales de SQL una vez completada la migración. -->
    <add name="CalandriaConn"
         connectionString="Server=100.75.234.9;Database=CALANDRIA;User Id=sa;Password=<CONTRASENA-PURGADA>;TrustServerCertificate=true;Encrypt=false;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
