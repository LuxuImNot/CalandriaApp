<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Solo existe si se copió connectionStrings.config.example -> connectionStrings.config
       (gitignorado). Sin ese archivo, los tests de integración contra la obra de
       prueba se saltan (ver ObraDePruebaFixture). -->
  <connectionStrings configSource="connectionStrings.config" />
  <appSettings>
    <!-- Secreto de prueba, 32+ bytes; nunca usar en un ambiente real. -->
    <add key="JwtSecreto" value="prueba-unidad-secreto-no-usar-en-produccion-0000" />
    <!-- AES-256 de prueba (32 bytes en Base64); nunca usar en un ambiente real. -->
    <add key="DocEncryptionKey" value="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=" />
    <add key="JwtIssuer" value="Calandria.Api.Tests" />
    <add key="JwtAudience" value="Calandria.Api.Tests" />
    <!-- Desactiva el emparejador automático (Ollama/Gemini) en pruebas: sin esto,
         ConciliadorFactura intentaría una llamada de red real. -->
    <add key="IaProveedor" value="None" />
  </appSettings>
</configuration>
